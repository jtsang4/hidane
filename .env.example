# hidane environment — copy to `.env` and fill in.
#
#   cp .env.example .env
#
# `.env` is gitignored. Two consumers read it:
#   - local dev: `pnpm dev` loads it (repo root) if present
#   - production: docker compose / Coolify substitute it into docker-compose.yml
# Every var is optional unless marked REQUIRED; defaults are what the code uses.

# ── Database ────────────────────────────────────────────────────────────────
# Local dev talks to the compose db on the uncommon port 2716.
DATABASE_URL=postgres://hidane:hidane@localhost:2716/hidane
# REQUIRED in production (compose builds DATABASE_URL from it).
POSTGRES_PASSWORD=

# ── Daemon ──────────────────────────────────────────────────────────────────
PORT=2718
# Workspaces, worklogs, memory and agent session traces. Production: /data.
HIDANE_HOME=

# ── Model ───────────────────────────────────────────────────────────────────
# Three things: which provider, which of its models, and that provider's key.
# Provider and model must be set together — a half-configured pair is a hard
# error, never a silent fallback to pi's default (that fallback once had
# production quietly running a different model than intended). The daemon also
# refuses to start on an unknown model or a missing key.
#
# Providers in pi's built-in catalog, nothing else to install:
#   deepseek     key: platform.deepseek.com
#                models: deepseek-v4-flash-vision-exp (images), deepseek-v4-pro,
#                deepseek-flash (added by deploy/pi-models.json in the image)
#   opencode-go  key: opencode.ai (OpenCode Go subscription)
#                models: deepseek-v4-flash-vision-exp, kimi-k3, qwen3.8-max,
#                glm-5.3, … — a wrong name makes the check list them all
# Choose a model with image input if pictures are sent (Feishu, web uploads).
# Check the combination with one real request:  pnpm dev model --ping
HIDANE_PI_PROVIDER=deepseek
HIDANE_PI_MODEL=deepseek-v4-flash-vision-exp
# Key for HIDANE_PI_PROVIDER, whichever it is.
HIDANE_PI_API_KEY=
# Older provider-specific name; still used when HIDANE_PI_API_KEY is empty.
DEEPSEEK_API_KEY=

# ── Agent tuning ────────────────────────────────────────────────────────────
HIDANE_ROUTE_THINKING=low
HIDANE_WORKER_THINKING=medium
HIDANE_ROUTE_TIMEOUT_SEC=180
HIDANE_WORKER_TIMEOUT_SEC=600
HIDANE_HEARTBEAT_SEC=300
HIDANE_DISTILL_SEC=600

# ── Runtime limits ──────────────────────────────────────────────────────────
# Worker subprocesses at once (further executions queue) and agent turns at once.
HIDANE_MAX_WORKERS=3
HIDANE_MAX_TURNS=4
# Longest causal chain of messages, and executions per work item, before a
# person is asked to continue — two agents waking each other cost a bounded amount.
HIDANE_MAX_HOPS=24
HIDANE_MAX_EXECUTIONS_PER_ITEM=12
# Below this routing confidence the Primary asks "which task?" instead of guessing.
HIDANE_ATTRIBUTION_THRESHOLD=0.6

# ── Access control ──────────────────────────────────────────────────────────
# Bearer token for /api/*; the web UI asks for it. REQUIRED in production —
# without it the whole API, including the event log, is world-readable.
HIDANE_API_TOKEN=
# HMAC-SHA256 secret for /webhook/* signatures. REQUIRED in production.
HIDANE_WEBHOOK_SECRET=

# ── Feishu channel binding (optional; connector stays off when unset) ────────
# App credentials from open.feishu.cn. Both must be set to enable the connector.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# One of the two below is REQUIRED once the connector is enabled: /feishu/events
# runs agent executions, so an unauthenticated endpoint hands anyone who knows
# the URL both your model spend and code execution. Events are rejected (401)
# when neither is set. The SDK's own token check is a no-op on plaintext v2
# events, so hidane enforces this itself.
FEISHU_VERIFICATION_TOKEN=
# AES-256-CBC decryption, when the app enables encrypted callbacks. An encrypted
# envelope authenticates itself, so this alone is sufficient.
FEISHU_ENCRYPT_KEY=
