# hidane environment — everything here is optional.
#
# The desktop app needs none of it: agents, LLM providers and models are chosen
# on the Settings page (stored in $HIDANE_HOME/settings.json). These variables
# are for `hidane serve`, the CLI and tuning. `.env` is gitignored; hidane does
# not read it by itself — export the variables or use your shell's dotenv tool.

# Data directory: SQLite log, settings, workspaces, worklogs, memory, traces.
HIDANE_HOME=

# ── hidane serve ────────────────────────────────────────────────────────────
HIDANE_ADDR=127.0.0.1:2718
# Bearer token for /api/*; a random one is generated per run when unset.
HIDANE_API_TOKEN=
# HMAC-SHA256 secret for /webhook/*. Set it whenever serve is reachable by others.
HIDANE_WEBHOOK_SECRET=

# ── Agent tuning ────────────────────────────────────────────────────────────
HIDANE_ROUTE_TIMEOUT_SEC=180
HIDANE_WORKER_TIMEOUT_SEC=600
HIDANE_HEARTBEAT_SEC=300
HIDANE_DISTILL_SEC=600

# ── Runtime limits ──────────────────────────────────────────────────────────
HIDANE_MAX_WORKERS=3
HIDANE_MAX_TURNS=4
HIDANE_MAX_HOPS=24
HIDANE_MAX_EXECUTIONS_PER_ITEM=12
HIDANE_ATTRIBUTION_THRESHOLD=0.6

# ── Feishu (long connection; also settable as `feishu` in settings.json) ────
FEISHU_APP_ID=
FEISHU_APP_SECRET=
