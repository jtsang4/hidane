{
  "name": "@hidane/server",
  "version": "0.1.0",
  "description": "hidane (火種) — a persistent personal agent runtime: event-log spine, work-item threads, three-scope pi agents",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jtsang4/hidane.git"
  },
  "bin": {
    "hidane": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "e2e": "tsx --env-file-if-exists=../../.env scripts/acceptance.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx --env-file-if-exists=../../.env scripts/e2e.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@hono/node-server": "^2.1.1",
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "hono": "^4.13.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
